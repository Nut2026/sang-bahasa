---
// ============================================================
// Sang Bahasa AdminTable Component
// Server-rendered table shell. JS handles all interactivity.
// ============================================================
---

<div id="admin-root">
  <!-- Token gate -->
  <div id="token-gate" class="admin-token-gate">
    <div class="admin-token-gate__title">🔒 Admin Access</div>
    <p class="admin-token-gate__subtitle">
      Masukkan token admin untuk mengakses panel pengurusan entri.
    </p>
    <div class="form-group">
      <input
        type="password"
        id="token-input"
        class="form-input"
        placeholder="Token admin..."
        autocomplete="current-password"
      />
    </div>
    <button id="token-submit" class="btn btn--primary" style="width:100%">
      Log Masuk
    </button>
    <p id="token-error" class="form-error" style="margin-top:var(--space-3); display:none;">
      Token tidak sah. Cuba lagi.
    </p>
  </div>

  <!-- Admin panel (hidden until token verified) -->
  <div id="admin-panel" style="display:none;">
    <div class="admin-page__header">
      <h1 class="admin-page__title">Pengurusan Entri</h1>
      <div style="display:flex; gap:var(--space-3); align-items:center; flex-wrap:wrap;">
        <span id="entry-count" class="results-count"></span>
        <button id="add-entry-btn" class="btn btn--primary">
          + Tambah Entri
        </button>
        <button id="logout-btn" class="btn btn--secondary btn--sm">
          Log Keluar
        </button>
      </div>
    </div>

    <!-- Search within admin -->
    <div style="margin-bottom:var(--space-6);">
      <input
        type="search"
        id="admin-search"
        class="form-input"
        placeholder="Cari dalam senarai..."
        style="max-width:400px;"
      />
    </div>

    <!-- Table -->
    <div style="overflow-x:auto;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Peribahasa</th>
            <th>Maksud (MS)</th>
            <th>Kategori</th>
            <th>Status</th>
            <th>Tindakan</th>
          </tr>
        </thead>
        <tbody id="entries-tbody">
          <tr>
            <td colspan="5" style="text-align:center; padding: var(--space-8);">
              <div class="spinner" style="margin:0 auto;"></div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="pagination" id="admin-pagination" style="display:none;"></div>
  </div>

  <!-- Entry modal -->
  <div id="entry-modal" class="modal-overlay" style="display:none;" role="dialog" aria-modal="true">
    <div class="modal">
      <div class="modal__header">
        <h2 class="modal__title" id="modal-title">Tambah Entri Baru</h2>
        <button class="modal__close" id="modal-close" aria-label="Tutup">✕</button>
      </div>

      <form id="entry-form" novalidate>
        <input type="hidden" id="entry-id" />

        <div class="form-group">
          <label for="f-phrase" class="form-label form-label--required">Peribahasa</label>
          <input type="text" id="f-phrase" class="form-input" required />
        </div>

        <div class="form-group">
          <label for="f-meaning-ms" class="form-label form-label--required">Maksud (Bahasa Melayu)</label>
          <textarea id="f-meaning-ms" class="form-textarea" required></textarea>
        </div>

        <div class="form-group">
          <label for="f-example-ms" class="form-label">Contoh Ayat (Melayu)</label>
          <textarea id="f-example-ms" class="form-textarea"></textarea>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-4);">
          <div class="form-group">
            <label for="f-category" class="form-label form-label--required">Kategori</label>
            <select id="f-category" class="form-select" required>
              <option value="nasihat">Nasihat</option>
              <option value="kerja_keras">Kerja Keras</option>
              <option value="kekeluargaan">Kekeluargaan</option>
              <option value="persahabatan">Persahabatan</option>
              <option value="kepimpinan">Kepimpinan</option>
              <option value="kesabaran">Kesabaran</option>
              <option value="keberanian">Keberanian</option>
              <option value="keadilan">Keadilan</option>
              <option value="tamak">Tamak</option>
              <option value="kejujuran">Kejujuran</option>
              <option value="ilmu">Ilmu</option>
              <option value="masa">Masa</option>
              <option value="rezeki">Rezeki</option>
              <option value="alam">Alam</option>
              <option value="lain_lain">Lain-lain</option>
            </select>
          </div>
          <div class="form-group">
            <label for="f-tags" class="form-label">Tag (koma-pisah)</label>
            <input type="text" id="f-tags" class="form-input" placeholder="nasihat, bijak, ..." />
          </div>
        </div>

        <div style="display:flex; gap:var(--space-4); margin-bottom:var(--space-5);">
          <label style="display:flex; align-items:center; gap:var(--space-2); cursor:pointer; font-size:var(--text-sm);">
            <input type="checkbox" id="f-published" checked /> Diterbitkan
          </label>
          <label style="display:flex; align-items:center; gap:var(--space-2); cursor:pointer; font-size:var(--text-sm);">
            <input type="checkbox" id="f-featured" /> Ditampilkan
          </label>
        </div>

        <p id="form-error" class="error-banner" style="display:none; margin-bottom:var(--space-4);"></p>

        <div style="display:flex; justify-content:flex-end; gap:var(--space-3);">
          <button type="button" id="form-cancel" class="btn btn--secondary">Batal</button>
          <button type="submit" id="form-submit" class="btn btn--primary">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // ============================================================
  // Admin Panel — Client-side logic
  // ============================================================

  const API = (window as any).__API_BASE__ || "http://localhost:8000";
  const STORAGE_KEY = "sang_bahasa_admin_token";

  // ── State ────────────────────────────────────────────────────
  let adminToken = sessionStorage.getItem(STORAGE_KEY) || "";
  let currentPage = 1;
  const PAGE_SIZE = 20;
  let editingId: string | null = null;
  let allEntries: any[] = [];

  // â”€â”€ Elements â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  const tokenGate   = document.getElementById("token-gate")!;
  const tokenInput  = document.getElementById("token-input") as HTMLInputElement;
  const tokenSubmit = document.getElementById("token-submit")!;
  const tokenError  = document.getElementById("token-error")!;
  const adminPanel  = document.getElementById("admin-panel")!;
  const tbody       = document.getElementById("entries-tbody")!;
  const pagination  = document.getElementById("admin-pagination")!;
  const entryCount  = document.getElementById("entry-count")!;
  const addBtn      = document.getElementById("add-entry-btn")!;
  const logoutBtn   = document.getElementById("logout-btn")!;
  const adminSearch = document.getElementById("admin-search") as HTMLInputElement;
  const modal       = document.getElementById("entry-modal")!;
  const modalTitle  = document.getElementById("modal-title")!;
  const modalClose  = document.getElementById("modal-close")!;
  const formCancel  = document.getElementById("form-cancel")!;
  const entryForm   = document.getElementById("entry-form") as HTMLFormElement;
  const formError   = document.getElementById("form-error")!;
  const formSubmit  = document.getElementById("form-submit")!;

  // â”€â”€ Token gate â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  function showPanel() {
    tokenGate.style.display = "none";
    adminPanel.style.display = "block";
    loadEntries();
  }

  if (adminToken) showPanel();

  tokenSubmit.addEventListener("click", async () => {
    const token = tokenInput.value.trim();
    if (!token) return;
    // Verify token by hitting a protected endpoint
    try {
      const res = await fetch(`${API}/api/admin/entries?page=1&page_size=1`, {
        headers: { "X-Admin-Token": token },
      });
      if (res.ok) {
        adminToken = token;
        sessionStorage.setItem(STORAGE_KEY, token);
        tokenError.style.display = "none";
        showPanel();
      } else {
        tokenError.style.display = "block";
      }
    } catch {
      tokenError.textContent = "Tidak dapat menghubungi pelayan. Cuba lagi.";
      tokenError.style.display = "block";
    }
  });

  tokenInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") tokenSubmit.click();
  });

  logoutBtn.addEventListener("click", () => {
    sessionStorage.removeItem(STORAGE_KEY);
    adminToken = "";
    adminPanel.style.display = "none";
    tokenGate.style.display = "block";
    tokenInput.value = "";
  });

  // â”€â”€ Load entries â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  async function loadEntries(page = 1) {
    currentPage = page;
    tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:var(--space-8);">
      <div class="spinner" style="margin:0 auto;"></div></td></tr>`;

    try {
      const res = await fetch(
        `${API}/api/admin/entries?page=${page}&page_size=${PAGE_SIZE}`,
        { headers: { "X-Admin-Token": adminToken } }
      );
      if (!res.ok) throw new Error(`${res.status}`);
      const data = await res.json();
      allEntries = data.items || [];
      renderTable(allEntries);
      renderPagination(data.total, data.page, data.page_size);
      entryCount.innerHTML = `<strong>${data.total}</strong> entri`;
    } catch (err) {
      tbody.innerHTML = `<tr><td colspan="5" class="error-banner">
        Gagal memuatkan entri. Semak sambungan atau token anda.</td></tr>`;
    }
  }

  // â”€â”€ Render table â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  function renderTable(entries: any[]) {
    if (!entries.length) {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:var(--space-8);
        color:var(--color-text-muted);">Tiada entri dijumpai.</td></tr>`;
      return;
    }

    tbody.innerHTML = entries.map((e) => `
      <tr>
        <td>
          <div class="admin-table__phrase">${escHtml(e.phrase)}</div>
          <div style="font-size:var(--text-xs);color:var(--color-text-subtle);
                      margin-top:2px;">${escHtml(e.slug)}</div>
        </td>
        <td class="admin-table__meaning">${escHtml(e.meaning_ms)}</td>
        <td>${escHtml(e.category)}</td>
        <td>
          ${e.is_published
            ? '<span class="badge badge--published">Diterbit</span>'
            : '<span class="badge badge--draft">Draf</span>'}
          ${e.is_featured
            ? ' <span class="badge badge--featured">â­</span>'
            : ""}
        </td>
        <td>
          <div class="admin-table__actions">
            <button class="btn btn--secondary btn--sm" onclick="editEntry('${e.id}')">Edit</button>
            <button class="btn btn--danger btn--sm" onclick="deleteEntry('${e.id}', '${escHtml(e.phrase)}')">Padam</button>
          </div>
        </td>
      </tr>
    `).join("");
  }

  // â”€â”€ Pagination â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  function renderPagination(total: number, page: number, pageSize: number) {
    const totalPages = Math.ceil(total / pageSize);
    if (totalPages <= 1) { pagination.style.display = "none"; return; }
    pagination.style.display = "flex";
    pagination.innerHTML = `
      <button class="pagination__btn" onclick="loadEntries(${page - 1})"
        ${page <= 1 ? "disabled" : ""}>← Sebelum</button>
      <span class="pagination__info">Halaman ${page} / ${totalPages}</span>
      <button class="pagination__btn" onclick="loadEntries(${page + 1})"
        ${page >= totalPages ? "disabled" : ""}>Seterusnya →</button>
    `;
  }

  // â”€â”€ Inline search â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  adminSearch.addEventListener("input", () => {
    const q = adminSearch.value.toLowerCase();
    const filtered = allEntries.filter(
      (e) =>
        e.phrase.toLowerCase().includes(q) ||
        e.meaning_ms.toLowerCase().includes(q) ||
        e.slug.toLowerCase().includes(q)
    );
    renderTable(filtered);
  });

  // â”€â”€ Modal helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  function openModal(title: string) {
    modalTitle.textContent = title;
    formError.style.display = "none";
    modal.style.display = "flex";
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.style.display = "none";
    document.body.style.overflow = "";
    entryForm.reset();
    editingId = null;
    (document.getElementById("entry-id") as HTMLInputElement).value = "";
  }

  modalClose.addEventListener("click", closeModal);
  formCancel.addEventListener("click", closeModal);
  modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });

  // â”€â”€ Add entry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  addBtn.addEventListener("click", () => {
    editingId = null;
    openModal("Tambah Entri Baru");
    (document.getElementById("f-published") as HTMLInputElement).checked = true;
    (document.getElementById("f-featured") as HTMLInputElement).checked = false;
  });

  // â”€â”€ Edit entry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  (window as any).editEntry = async (id: string) => {
    const entry = allEntries.find((e) => e.id === id);
    if (!entry) return;
    editingId = id;
    (document.getElementById("entry-id") as HTMLInputElement).value = id;
    (document.getElementById("f-phrase") as HTMLInputElement).value = entry.phrase;
    (document.getElementById("f-meaning-ms") as HTMLTextAreaElement).value = entry.meaning_ms;
    (document.getElementById("f-example-ms") as HTMLTextAreaElement).value = entry.example_ms || "";
    (document.getElementById("f-category") as HTMLSelectElement).value = entry.category;
    (document.getElementById("f-tags") as HTMLInputElement).value = entry.tags.join(", ");
    (document.getElementById("f-published") as HTMLInputElement).checked = entry.is_published;
    (document.getElementById("f-featured") as HTMLInputElement).checked = entry.is_featured;
    openModal("Edit Entri");
  };

  // â”€â”€ Delete entry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  (window as any).deleteEntry = async (id: string, phrase: string) => {
    if (!confirm(`Padam "${phrase}"?\n\nTindakan ini tidak boleh dibatalkan.`)) return;
    try {
      const res = await fetch(`${API}/api/admin/entries/${id}`, {
        method: "DELETE",
        headers: { "X-Admin-Token": adminToken },
      });
      if (!res.ok) throw new Error(`${res.status}`);
      await loadEntries(currentPage);
    } catch {
      alert("Gagal memadam entri. Cuba lagi.");
    }
  };

  // â”€â”€ Form submit â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  entryForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    formError.style.display = "none";
    formSubmit.textContent = "Menyimpan...";
    formSubmit.setAttribute("disabled", "true");

    const phrase    = (document.getElementById("f-phrase") as HTMLInputElement).value.trim();
    const meaningMs = (document.getElementById("f-meaning-ms") as HTMLTextAreaElement).value.trim();
    const exampleMs = (document.getElementById("f-example-ms") as HTMLTextAreaElement).value.trim();
    const category  = (document.getElementById("f-category") as HTMLSelectElement).value;
    const tagsRaw   = (document.getElementById("f-tags") as HTMLInputElement).value;
    const tags      = tagsRaw.split(",").map((t) => t.trim().toLowerCase()).filter(Boolean);
    const published = (document.getElementById("f-published") as HTMLInputElement).checked;
    const featured  = (document.getElementById("f-featured") as HTMLInputElement).checked;

    const body: Record<string, unknown> = {
      phrase, meaning_ms: meaningMs,
      example_ms: exampleMs || null,
      category, tags, is_published: published, is_featured: featured,
    };

    const isEdit = Boolean(editingId);
    const url = isEdit
      ? `${API}/api/admin/entries/${editingId}`
      : `${API}/api/admin/entries`;
    const method = isEdit ? "PUT" : "POST";

    try {
      const res = await fetch(url, {
        method,
        headers: {
          "Content-Type": "application/json",
          "X-Admin-Token": adminToken,
        },
        body: JSON.stringify(body),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.detail || `HTTP ${res.status}`);
      }

      closeModal();
      await loadEntries(currentPage);
    } catch (err: any) {
      formError.textContent = `Ralat: ${err.message}`;
      formError.style.display = "flex";
    } finally {
      formSubmit.textContent = "Simpan";
      formSubmit.removeAttribute("disabled");
    }
  });

  // â”€â”€ Utility â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  function escHtml(str: string): string {
    return String(str ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }
</script>
