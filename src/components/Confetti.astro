<canvas id="confetti-canvas" hidden></canvas>

<style>
  #confetti-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
  }
</style>

<script>
  class Particle {
    constructor(canvas, x, y, vx, vy) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d');
      this.x = x;
      this.y = y;
      this.vx = vx;
      this.vy = vy;
      
      this.friction = 0.97;
      this.gravity = 0.25;
      
      this.size = Math.random() * 8 + 6;
      this.opacity = 1;
      
      const emeraldShades = ['#064E3B', '#065F46', '#047857', '#10B981', '#34D399', '#6EE7B7'];
      this.color = emeraldShades[Math.floor(Math.random() * emeraldShades.length)];
      
      this.rotation = Math.random() * 360;
      this.rotationSpeed = (Math.random() - 0.5) * 15;
    }

    update(mouse) {
      const dx = this.x - mouse.x;
      const dy = this.y - mouse.y;
      const distance = Math.sqrt(dx * dx + dy * dy);
      if (distance < 180) {
        const force = (180 - distance) / 180;
        this.vx += (dx / distance) * force * 4;
        this.vy += (dy / distance) * force * 4;
      }

      this.vx *= this.friction;
      this.vy += this.gravity;
      this.x += this.vx;
      this.y += this.vy;
      this.rotation += this.rotationSpeed;

      if (this.y > this.canvas.height * 0.8) {
        this.opacity -= 0.02;
      }
    }

    draw() {
      if (this.opacity <= 0) return;
      this.ctx.save();
      this.ctx.translate(this.x, this.y);
      this.ctx.rotate((this.rotation * Math.PI) / 180);
      const scaleX = Math.cos(this.rotation * 0.1);
      this.ctx.scale(scaleX, 1);
      this.ctx.fillStyle = this.color;
      this.ctx.globalAlpha = this.opacity;
      this.ctx.fillRect(-this.size / 2, -this.size / 2, this.size, this.size / 1.5);
      this.ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
      this.ctx.lineWidth = 1;
      this.ctx.strokeRect(-this.size / 2, -this.size / 2, this.size, this.size / 1.5);
      this.ctx.restore();
    }
  }

  let particles = [];
  let animationFrame;
  let spawning = false;
  const mouse = { x: -9999, y: -9999 };

  function initConfetti() {
    const canvas = document.getElementById('confetti-canvas');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    canvas.hidden = false;

    particles = [];
    spawning = true;
    
    // Spewing logic: Emit particles over 400ms instead of all at once
    let start = null;
    const duration = 400; // ms
    const totalParticles = 600;

    function spawn(timestamp) {
      if (!start) start = timestamp;
      const progress = timestamp - start;
      
      // Calculate how many particles to add this frame
      const countThisFrame = Math.floor((totalParticles / duration) * 16); 
      
      for (let i = 0; i < countThisFrame; i++) {
        if (particles.length >= totalParticles) break;

        // Left Spew (with slight random origin offset to prevent "block" look)
        particles.push(new Particle(
          canvas, 
          -10, canvas.height * 0.8 + (Math.random() * 20), 
          Math.random() * 25 + 5, Math.random() * -25 - 15
        ));

        // Right Spew
        particles.push(new Particle(
          canvas, 
          canvas.width + 10, canvas.height * 0.8 + (Math.random() * 20), 
          Math.random() * -25 - 5, Math.random() * -25 - 15
        ));
      }

      if (progress < duration && particles.length < totalParticles) {
        requestAnimationFrame(spawn);
      }
    }

    requestAnimationFrame(spawn);
    runAnimation();

    // Clean up
    setTimeout(() => {
      cancelAnimationFrame(animationFrame);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles = [];
      canvas.hidden = true;
    }, 8000);
  }

  function runAnimation() {
    const canvas = document.getElementById('confetti-canvas');
    if (!canvas || canvas.hidden) return;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.update(mouse);
      p.draw();
      if (p.y > canvas.height + 20 || p.opacity <= 0) {
        particles.splice(i, 1);
      }
    }

    animationFrame = requestAnimationFrame(runAnimation);
  }

  window.addEventListener('mousemove', (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function checkTrigger() {
    if (sessionStorage.getItem('showConfetti') === 'true') {
      sessionStorage.removeItem('showConfetti');
      setTimeout(initConfetti, 50);
    }
  }

  document.addEventListener('DOMContentLoaded', checkTrigger);
</script>