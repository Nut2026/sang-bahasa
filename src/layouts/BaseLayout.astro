---
import '../assets/css/main.css';
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
}

const {
  title,
  description = "Kamus peribahasa Melayu dan bahasa Melayu klasik yang lengkap dengan makna, contoh ayat, dan carian yang mudah digunakan.",
  ogImage = "/og-default.png",
  canonicalUrl,
  noIndex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "http://localhost:4321";
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = title.includes("Sang Bahasa")
  ? title
  : `${title} — Sang Bahasa`;
const pathname = Astro.url.pathname;
const isKamusRoute = pathname.startsWith("/kamus");
const isKamusAll = pathname === "/kamus" || pathname.startsWith("/kamus/search");
const isKamusPeribahasa = pathname.startsWith("/kamus/peribahasa");
const isKamusBahasaKlasik = pathname.startsWith("/kamus/bahasa-klasik");
---

<!doctype html>
<html lang="ms">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content="ms_MY" />
    <meta property="og:site_name" content="Sang Bahasa" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#2d6a4f" />
    <meta name="author" content="Sang Bahasa" />
    <meta name="keywords" content="kamus, peribahasa, bahasa melayu, bahasa klasik, kamus peribahasa, kamus bahasa melayu" />

    <style is:inline>
      .footer-tooltip {
        position: relative;
        display: inline-flex;
        align-items: center;
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #9c9188;
        font-size: 13px;
        cursor: default;
        line-height: 1.3;
      }

      .footer-tooltip__panel {
        display: none;
        position: absolute;
        left: -20px;
        bottom: calc(100% + 10px);
        width: min(200px, 80vw);
        padding: 0.5rem 0.8rem;
        background: rgb(255, 255, 255);
        color: #2d6a4f;
        border-radius: 12px;
        border: 1px solid #d3d3d3; /* Thin grey border */
        box-shadow: 0 20px 38px rgba(0, 0, 0, 0.22);
        white-space: normal;
        line-height: 1.5;
        font-size: 12.75px;
        text-align: left;
        z-index: 10;
      }

      .footer-tooltip:hover .footer-tooltip__panel,
      .footer-tooltip:focus-within .footer-tooltip__panel {
        display: block;
      }
    </style>

    <script is:inline>
      // Check screen size and show warning popup if needed
      function checkScreenSize() {
        const minWidth = 350; // Minimum comfortable width
        const screenWidth = window.innerWidth;
        
        if (screenWidth < minWidth && !sessionStorage.getItem('screenSizeWarningShown')) {
          const isPortrait = window.matchMedia('(orientation: portrait)').matches;
          const message = isPortrait 
            ? 'Laman web ini mungkin tidak papar dengan baik pada skrin yang sangat kecil. Sila pusingkan peranti anda ke orientasi landskap atau besarkan tetingkap penyemak imbas anda untuk pengalaman yang lebih baik.'
            : '\nMaaf, Sang Bahasa mungkin tidak papar dengan baik pada dimensi yang sempit.';
          
          if (confirm(message + '\n\nSila pusingkan peranti anda ke orientasi landskap (disyorkan) atau luaskan penyemak imbas anda untuk pengalaman yang lebih baik. Terima kasih!')) {
            sessionStorage.setItem('screenSizeWarningShown', 'true');
          }
        }
      }
      
      // Check on load and resize
      window.addEventListener('load', checkScreenSize);
      window.addEventListener('resize', () => {
        if (!sessionStorage.getItem('screenSizeWarningShown')) {
          checkScreenSize();
        }
      });
    </script>

    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5305624494969897" crossorigin="anonymous" title="Google Adsense"></script>
    <meta name="google-site-verification" content="8byTqO1tCJEM1IxvmnBaBb7Y7GFpXTpH-g22Jktbotg" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container">
        <div class="site-header__inner">
          <a href="/" class="site-logo" aria-label="Sang Bahasa Laman Utama">
            Sang Bahasa
          </a>
          <nav class="site-nav" aria-label="Main navigation">
            <a href="/" aria-current={pathname === "/" ? "page" : undefined} aria-label="Laman Utama">
              Laman Utama
            </a>
            <div class="nav-dropdown-wrapper">
              <button 
                class="nav-kamus-btn" 
                aria-expanded="false" 
                aria-haspopup="true"
                aria-controls="kamus-menu"
                aria-label="Buka menu kamus"
                aria-current={isKamusRoute ? "page" : undefined}
              >
                Kamus
              </button>
              <ul id="kamus-menu" class="nav-dropdown-menu" role="menu" aria-label="Submenu Kamus">
                <li role="none">
                  <a href="/kamus" role="menuitem" aria-label="Semua Kamus" class={`dropdown-item ${isKamusAll ? "dropdown-item--active" : ""}`}>Semua</a>
                </li>
                <li role="none">
                  <a href="/kamus/peribahasa" role="menuitem" aria-label="Kamus Peribahasa" class={`dropdown-item ${isKamusPeribahasa ? "dropdown-item--active" : ""}`}>Peribahasa</a>
                </li>
                <li role="none">
                  <a href="/kamus/bahasa-klasik" role="menuitem" aria-label="Kamus Bahasa Klasik" class={`dropdown-item ${isKamusBahasaKlasik ? "dropdown-item--active" : ""}`}>Bahasa Klasik</a>
                </li>
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__inner">
          <div class="site-footer__left">
            <p class="site-footer__tagline site-footer__tagline--footer">
              Sang Bahasa ~ Bangga cipta Malaysia
            </p>
            <p class="site-footer__copy">
              &copy; {new Date().getFullYear()} Sang Bahasa. Hak cipta terpelihara.
            </p>
          </div>
          <nav class="site-footer__links" aria-label="Pautan tapak" style="display: grid; grid-template-columns: auto auto; gap: 5px 25px; justify-content: start;">
            <span class="footer-tooltip">
              Kenali Sang Bahasa
              <span class="footer-tooltip__panel"><strong>Sang Bahasa</strong><br>— Kamus Bahasa Melayu yang paling dekat di hati</span>
            </span>
            <a href="/dasar-privasi" style="font-family: Georgia, 'Times New Roman', Times, serif; color: #9c9188; font-size: 13px;" data-astro-prefetch>Dasar Privasi</a>
            <a href="/hubungi-kami" style="font-family: Georgia, 'Times New Roman', Times, serif; color: #9c9188; font-size: 13px;" data-astro-prefetch>Hubungi Kami</a>
            <a href="/penafian" style="font-family: Georgia, 'Times New Roman', Times, serif; color: #9c9188; font-size: 13px;" data-astro-prefetch>Penafian</a>
          </nav>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Global tracking function
      window.trackTrenDuniaView = function(wordType, slug) {
        const url = "/api/tren-dunia/track";
        const body = JSON.stringify({ wordType, slug });
        try {
          if (navigator.sendBeacon) {
            navigator.sendBeacon(
              url,
              new Blob([body], { type: "application/json" })
            );
          } else {
            fetch(url, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body,
              keepalive: true,
            });
          }
        } catch (_) {}
      };

      // Handle Kamus dropdown navigation
      document.addEventListener("DOMContentLoaded", () => {
        const kamusBtn = document.querySelector(".nav-kamus-btn");
        const dropdownMenu = document.querySelector(".nav-dropdown-menu");
        
        if (!kamusBtn || !dropdownMenu) return;

        // Toggle dropdown on button click only
        kamusBtn.addEventListener("click", (e) => {
          e.preventDefault();
          const isOpen = kamusBtn.getAttribute("aria-expanded") === "true";
          
          if (isOpen) {
            // Close dropdown if already open
            kamusBtn.setAttribute("aria-expanded", "false");
            dropdownMenu.classList.remove("active");
          } else {
            // Open dropdown on click
            kamusBtn.setAttribute("aria-expanded", "true");
            dropdownMenu.classList.add("active");
          }
        });

        // Close dropdown when a menu item is clicked
        document.querySelectorAll(".dropdown-item").forEach((item) => {
          item.addEventListener("click", () => {
            kamusBtn.setAttribute("aria-expanded", "false");
            dropdownMenu.classList.remove("active");
          });
        });

        // Close dropdown when clicking outside
        document.addEventListener("click", (e) => {
          const target = e.target instanceof Element ? e.target : null;
          if (!target?.closest(".nav-dropdown-wrapper")) {
            kamusBtn.setAttribute("aria-expanded", "false");
            dropdownMenu.classList.remove("active");
          }
        });
      });
    </script>
    
    <Analytics />
    <SpeedInsights />
  </body>
</html>