---
export const prerender = false;

import AdminTable from "../../components/AdminTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Supabase is now the only data source - no backend API needed
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const isSupabaseConfigured = Boolean(supabaseUrl);
---

<BaseLayout
  title="Admin — Sang Bahasa"
  description="Panel pengurusan entri Sang Bahasa."
  noIndex={true}
>
  <script is:inline define:vars={{ isSupabaseConfigured }}>
    window.__USE_SUPABASE__ = isSupabaseConfigured;
  </script>

  <div class="admin-page">
    <div class="container container--wide">
      <AdminTable />
    </div>
  </div>
</BaseLayout>
