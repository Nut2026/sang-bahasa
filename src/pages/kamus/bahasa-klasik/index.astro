---
export const prerender = false;

import SearchBar from "@/components/SearchBar.astro";
import SearchNoMatchChampion from "@/components/SearchNoMatchChampion.astro";
import ResultCard from "@/components/ResultCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

import type { SearchResult, PeribahasaSummary } from "@/config/apiConfig";
import { resolveSearchResults } from "@/utils/searchResults";
import { getTopTrenDuniaSummaries } from "@/utils/trenDunia";
import {
  formatMalayLabel,
  getAvailableTags,
  getEntriesByWordType,
  normalizeTag,
} from "@/utils/kamus";

const url = Astro.url;

const query = url.searchParams.get("q")?.trim() || "";
const selectedTag = url.searchParams.get("tag") || url.searchParams.get("category") || "";
const selectedCategory = normalizeTag(selectedTag);
const selectedType = normalizeTag(url.searchParams.get("type") || "");
const page = Math.max(1, Number(url.searchParams.get("page")) || 1);
const availableTags = getAvailableTags(await getEntriesByWordType("bahasa-klasik"));

const PAGE_SIZE = 10;
const WORD_TYPE = "bahasa-klasik";
const BASE_URL = "/kamus/bahasa-klasik";

let results: SearchResult | null = null;
let error = "";
let suggestions: PeribahasaSummary[] = [];
let similarEntries: PeribahasaSummary[] = [];

try {
  const resolved = await resolveSearchResults({
    query,
    category: selectedCategory,
    type: selectedType || undefined,
    page,
    pageSize: PAGE_SIZE,
    wordType: WORD_TYPE,
  });
  results = resolved.result;
  suggestions = resolved.suggestions;
  similarEntries = resolved.similarEntries;
} catch {
  error = "Tidak dapat menghubungi pelayan. Sila cuba sebentar lagi.";
}

const entries = results?.results ?? [];
const total = results?.total ?? 0;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

// Check if there's no exact match
const showNoMatch = query.length > 0 && entries.length === 0 && !error;

// Get up to 5 similar entries for the "Adakah anda mencari" section
const closestMatches = similarEntries.slice(0, 5);

// Only show champion if there are no closest matches
let championsWhenNoMatch: PeribahasaSummary[] = [];
if (showNoMatch && closestMatches.length === 0) {
  try {
    const tops = await getTopTrenDuniaSummaries(3, WORD_TYPE);
    championsWhenNoMatch = tops;
  } catch {
    championsWhenNoMatch = [];
  }
}

// Truncate query for display (max 27 characters)
function truncateQuery(q: string, maxLen: number = 27): string {
  if (q.length <= maxLen) return q;
  return q.slice(0, maxLen) + "...";
}

const displayQuery = truncateQuery(query);

function buildUrl(nextPage: number) {
  const params = new URLSearchParams();

  if (query) params.set("q", query);
  if (selectedCategory) params.set("category", selectedCategory);
  if (selectedType) params.set("type", selectedType);

  params.set("page", String(nextPage));

  return `${BASE_URL}?${params.toString()}`;
}

function buildFilterUrl(tag: string) {
  const params = new URLSearchParams();

  if (query) params.set("q", query);
  if (tag) params.set("category", normalizeTag(tag));
  if (selectedType) params.set("type", selectedType);

  return params.toString() ? `${BASE_URL}?${params.toString()}` : BASE_URL;
}

const pageTitle = query
  ? `Hasil carian Bahasa Klasik: "${displayQuery}"`
  : "Bahasa Klasik";

const metaDesc = query
  ? `${total} Bahasa Klasik dijumpai untuk carian "${displayQuery}".`
  : "Semak imbas koleksi Bahasa Klasik Melayu dengan makna dan contoh ayat.";
---

<BaseLayout title={pageTitle} description={metaDesc}>
  <div data-search-root style="padding: var(--space-8) 0 var(--space-4);">
    <div class="container">
      <div style="margin-bottom: var(--space-6);">
        <SearchBar initialValue={query} autofocus={!query} placeholder="Cari bahasa klasik..." wordType={WORD_TYPE} />
      </div>

      <div class="category-pills">
        <a href={buildFilterUrl("")} class={`category-pill ${selectedCategory ? "" : "category-pill--active"}`}>
          Semua
        </a>
        {availableTags.map((tag) => (
          <a
            href={buildFilterUrl(tag)}
            class={`category-pill ${selectedCategory === normalizeTag(tag) ? "category-pill--active" : ""}`}
          >
            {formatMalayLabel(tag)}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div style="padding-bottom: var(--space-16);">
    <div class="container">
      {error && (
        <div class="error-banner" role="alert">
          {error}
        </div>
      )}

      {!error && (
        <div class="results-header">
          <p class="results-count">
            {query ? (
              <>
                <strong>{total}</strong> keputusan untuk &ldquo;{displayQuery}&rdquo;
              </>
            ) : (
              <>
                Menunjukkan <strong>{entries.length}</strong> daripada{" "}
                <strong>{total}</strong> bahasa klasik
              </>
            )}
          </p>
        </div>
      )}

      {/* RESULTS SECTION */}
      {entries.length > 0 && !error && (
        <>
          <div class="results-grid">
            {entries.map((entry) => (
              <ResultCard entry={entry} wordType={WORD_TYPE} />
            ))}
          </div>

          <div class="search-actions search-actions--all" style="margin-top: var(--space-10); margin-bottom: var(--space-4);">
            <a href="/kamus" class="btn btn--secondary">
              &larr; Kembali ke Semua
            </a>
            <button type="button" class="btn btn--secondary" data-cari-lagi>
              Cari lagi
            </button>
          </div>
        </>
      )}

      {/* NO MATCH SECTION */}
      {showNoMatch && (
        <>
          <div class="empty-state">
            <div class="empty-state__icon">🔎</div>

            <h2 class="empty-state__title">
              Tiada padanan tepat dijumpai
            </h2>

            <p class="empty-state__text">
              {query
                ? (
                  <>
                    Tiada carian tepat untuk "<span class="truncated-query">{displayQuery}</span>". Cuba semak ejaan atau <a href="https://forms.gle/EEKuNwG3V1ZPGhTT6" class="lihat-semua" target="_blank" rel="noopener noreferrer">hantar cadangan anda</a> di Google Forms.
                  </>
                )
                : "Oops! Maaf, Sang Bahasa belum cukup 'tech' membaca minda anda. Cuba taip sesuatu untuk melihat ajaib."}
            </p>
          </div>

          {closestMatches.length > 0 && (
            <div class="closest-matches" style="margin-top: var(--space-6); margin-bottom: var(--space-10);">
              <p style="font-weight: 600; margin-bottom: var(--space-3);">Adakah anda mencari satu daripada ini?</p>
              <div class="results-grid">
                {closestMatches.map((entry) => (
                  <ResultCard entry={entry} wordType={WORD_TYPE} />
                ))}
              </div>
            </div>
          )}

          {/* Champion Section with spacing */}
          <div style="margin-top: var(--space-2); margin-bottom: var(--space-8);">
            <SearchNoMatchChampion champions={championsWhenNoMatch} showSection={closestMatches.length === 0} />
          </div>

          {/* Buttons with proper spacing */}
          <div class="search-actions search-actions--all" style="margin-top: var(--space-10); margin-bottom: var(--space-4);">
            <a href={BASE_URL} class="btn btn--secondary">
              Lihat semua entri
            </a>
            <button type="button" class="btn btn--secondary" data-cari-lagi>
              Cari lagi
            </button>
          </div>

          {/* Back to Semua button */}
          <div style="margin-top: var(--space-4);">
            <a href="/kamus" class="btn btn--secondary">
              &larr; Kembali ke Semua
            </a>
          </div>
        </>
      )}

      {/* PAGINATION */}
      {totalPages > 1 && (
        <nav class="pagination" aria-label="Pagination">
          {page > 1 && (
            <a href={buildUrl(page - 1)} class="pagination__link pagination__link--prev">
              &larr; Sebelumnya
            </a>
          )}

          <span class="pagination__info">
            Halaman {page} daripada {totalPages}
          </span>

          {page < totalPages && (
            <a href={buildUrl(page + 1)} class="pagination__link pagination__link--next">
              Seterusnya &rarr;
            </a>
          )}
        </nav>
      )}
    </div>
  </div>
</BaseLayout>

<style is:global>
  .truncated-query {
    font-weight: 600;
  }

  .lihat-semua {
    color: #065f46;
    text-decoration: underline;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .lihat-semua:hover {
    color: #064e3b;
  }

  .search-actions--all {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
  }
</style>

<script is:inline>
  document.addEventListener("click", (e) => {
    const btn = e.target?.closest?.("[data-cari-lagi]");
    if (!btn) return;

    window.scrollTo({ top: 0, behavior: "smooth" });

    window.setTimeout(() => {
      const root = document.querySelector("[data-search-root]");
      const input = root?.querySelector("[data-search-input]");
      if (!input) return;

      if (typeof root?.focusSearchInput === "function") {
        root.focusSearchInput();
      } else {
        input.focus();
        const len = input.value?.length ?? 0;
        try {
          input.setSelectionRange(len, len);
        } catch {
          input.value = input.value;
        }
      }
    }, 250);
  });
</script>