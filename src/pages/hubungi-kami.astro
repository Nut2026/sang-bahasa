---
import BaseLayout from "../layouts/BaseLayout.astro";

// Get emails from environment variables
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || "Alamak jumpa Si Ralat!";
const privacyEmail = import.meta.env.PUBLIC_PRIVACY_EMAIL || "Alamak jumpa Si Ralat!";
---

<BaseLayout
  title="Hubungi Kami"
  description="Ada soalan, cadangan, atau laporan tentang Sang Bahasa? Hubungi kami — kami sedia mendengar."
>
  <article class="static-page">
    <div class="container container--narrow">
      <h1 class="static-page__title">Hubungi Kami</h1>
      
      <div class="static-page__body">
        <p class="intro-message">
          Untuk sebarang sumbangan, soalan, atau kerjasama
        </p>
        <h2>Borang</h2>
        <p>
          Jom sumbang melalui Google Forms:
        </p>
        <p>
          <strong>Kongsikan Perkataan Baharu, Cadangan atau Maklum Balas Anda:</strong> 
          <a href="https://forms.gle/4niHmyeJaRLgZkYH9" target="_blank" rel="noopener noreferrer">https://forms.gle/4niHmyeJaRLgZkYH9</a>
          <br>
          <strong>Laporkan Ralat:</strong><br>
          <a href="https://forms.gle/SchPdcyoQRGCqC5J8" target="_blank" rel="noopener noreferrer">https://forms.gle/SchPdcyoQRGCqC5J8</a>
        </p>
        <h2>Emel</h2>
        <p>
          Atau hantarkan emel anda kepada:
        </p>
        
        <div class="email-copy-container">
          <code id="contactEmail" class="contact-email" data-email-value={contactEmail}>{contactEmail}</code>
          <span id="contactTick" class="tick-indicator"></span>
        </div>

        <hr class="contact-divider" />

        <div class="contact-thankyou">
          <p>
            <strong>Terima kasih</strong> kerana menyokong bahasa Melayu. 
            <br>Setiap mesej anda membantu menjadikan Sang Bahasa lebih baik.
          </p>
          <p class="signature">
            — Sang Bahasa, Kamus Bahasa Melayu yang paling dekat di hati.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .intro-message {
    font-size: 1.1rem;
    line-height: 1.6;
    background: #f5f0eb;
    padding: 1rem 1.2rem;
    border-radius: 16px;
    color: #2d6a4f;
    margin-bottom: 1.5rem;
  }
  
  .email-copy-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 0.5rem 0 0.25rem 0;
  }
  
  .contact-email {
    font-size: 1.1rem;
    font-family: 'Courier New', monospace;
    color: #2d6a4f;
    background: #f5f0eb;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    display: inline-block;
    cursor: pointer;
    transition: all 0.2s ease;
    /* Prevents the blue text highlight/selection on click */
    user-select: none;
    -webkit-tap-highlight-color: transparent; 
  }
  
  .contact-email:hover {
    background: #e8e0d8;
    transform: scale(1.02);
  }
  
  .contact-email:active {
    transform: scale(0.98);
  }
  
  .tick-indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    opacity: 0;
    transition: opacity 0.2s ease;
    min-width: 30px;
  }
  
  .tick-indicator.show {
    opacity: 1;
  }
  
  .contact-divider {
    margin: 2rem 0 1.5rem 0;
    border: none;
    border-top: 1px solid #d3d3d3;
  }
  
  .contact-thankyou {
    background: #e8f3ef;
    padding: 1.2rem 1.5rem;
    border-radius: 16px;
    text-align: center;
    color: #15422f;
    margin-top: 1rem;
  }
  
  .contact-thankyou p {
    margin-bottom: 0.5rem;
  }
  
  .signature {
    font-size: 0.85rem;
    color: #7a9e8a;
    font-style: italic;
    margin-top: 0.75rem;
  }

  /* Style for links */
  .static-page__body a {
    color: #2d6a4f;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .static-page__body a:hover {
    color: #1b4332;
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .intro-message {
      font-size: 1rem;
      padding: 0.8rem 1rem;
    }
    
    .contact-email {
      font-size: 0.9rem;
      word-break: break-all;
    }
    
    .email-copy-container {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .tick-indicator {
      margin-left: 0.5rem;
    }
  }
</style>

<script>
  function setupEmailCopy() {
    const emails = document.querySelectorAll('.contact-email');
    
    emails.forEach(emailElement => {
      emailElement.addEventListener('click', async () => {
        const email = emailElement.getAttribute('data-email-value') || emailElement.textContent;
        const tickIndicator = emailElement.parentElement.querySelector('.tick-indicator');
        
        try {
          await navigator.clipboard.writeText(email);
          
          tickIndicator.textContent = '🗐';
          tickIndicator.classList.add('show');
          
          setTimeout(() => {
            tickIndicator.classList.remove('show');
            setTimeout(() => {
              if (!tickIndicator.classList.contains('show')) {
                tickIndicator.textContent = '';
              }
            }, 200);
          }, 1500);
          
        } catch (err) {
          const textarea = document.createElement('textarea');
          textarea.value = email;
          // Hide textarea from view
          textarea.style.position = 'fixed';
          textarea.style.left = '-9999px';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
          
          tickIndicator.textContent = '🗐';
          tickIndicator.classList.add('show');
          
          setTimeout(() => {
            tickIndicator.classList.remove('show');
            setTimeout(() => {
              if (!tickIndicator.classList.contains('show')) {
                tickIndicator.textContent = '';
              }
            }, 200);
          }, 1500);
        }
      });
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupEmailCopy);
  } else {
    setupEmailCopy();
  }
</script>