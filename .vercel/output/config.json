{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_assets/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/random/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/search/suggestions/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/tren-dunia/track/?$",
			"dest": "_render"
		},
		{
			"src": "^/kamus/bahasa-klasik/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/kamus/bahasa-klasik/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/kamus/bahasa-klasik/?$",
			"dest": "_render"
		},
		{
			"src": "^/kamus/peribahasa/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/kamus/peribahasa/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/kamus/peribahasa/?$",
			"dest": "_render"
		},
		{
			"src": "^/kamus/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/kamus/semua/?$",
			"dest": "_render"
		},
		{
			"src": "^/kamus/?$",
			"dest": "_render"
		},
		{
			"src": "^/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}